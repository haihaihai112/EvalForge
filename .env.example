# Copy to .env. Do not commit .env or put keys into frontend code.
EVALFORGE_PORT=8791
# Base URL must include the API version path; /chat/completions is appended.
EVALFORGE_API_BASE=
EVALFORGE_API_KEY=
EVALFORGE_MODEL=
# USD per 1,000,000 input/output tokens; blank means cost unknown, not zero.
EVALFORGE_INPUT_PRICE=
EVALFORGE_OUTPUT_PRICE=
# Two independently running HTTP Agent endpoints, absolute /answer URLs.
EVALFORGE_AGENT_1_NAME=LogiGraph v1.0
EVALFORGE_AGENT_1_URL=
EVALFORGE_AGENT_1_TOKEN=
EVALFORGE_AGENT_2_NAME=LogiGraph v2.0
EVALFORGE_AGENT_2_URL=
EVALFORGE_AGENT_2_TOKEN=
# Optional custom SQLite path. Default: project/data/evalforge.db
# EVALFORGE_DB=C:/your-local-path/evalforge.db
